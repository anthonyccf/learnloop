# Copy to .env and fill in the deployment-specific values.
# Backend only. Never expose credentials through NEXT_PUBLIC_* variables.

# Relative SQLite paths resolve from backend/, regardless of the launch directory.
DATABASE_URL=sqlite:///data/learnloop.db

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_ENDPOINT=/api/embed
EMBEDDING_DIMENSIONS=1024

# No PostgreSQL or Qdrant service is required. sqlite-vec is installed by pip.

API_TOKEN=REPLACE_WITH_A_RANDOM_LOCAL_BACKEND_TOKEN
LOCAL_OWNER_ID=local-owner
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna

# Optional limits (defaults shown)
REQUEST_TIMEOUT_SECONDS=90
MAX_UPLOAD_BYTES=20971520
MAX_PAGES=200
MAX_CHUNKS=1000
WORKER_LEASE_SECONDS=1800
WORKER_MAX_ATTEMPTS=3
