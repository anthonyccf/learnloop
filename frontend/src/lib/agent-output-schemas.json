  "expert.analysis": {
    "SectionGraph": {
      "$defs": {
        "Concept": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "pattern": "^[a-z][a-z0-9-]{0,62}$",
              "title": "Id",
              "type": "string"
            },
            "title": {
              "maxLength": 150,
              "minLength": 1,
              "title": "Title",
              "type": "string"
            },
            "summary": {
              "maxLength": 1000,
              "minLength": 10,
              "title": "Summary",
              "type": "string"
            },
            "sources": {
              "items": {
                "$ref": "#/$defs/Source"
              },
              "maxItems": 4,
              "minItems": 1,
              "title": "Sources",
              "type": "array"
            },
            "targetDifficulty": {
              "default": "intermediate",
              "enum": [
                "basic",
                "intermediate",
                "advanced"
              ],
              "title": "Targetdifficulty",
              "type": "string"
            }
          },
          "required": [
            "id",
            "title",
            "summary",
            "sources",
            "targetDifficulty"
          ],
          "title": "Concept",
          "type": "object"
        },
        "Edge": {
          "additionalProperties": false,
          "properties": {
            "prerequisite": {
              "title": "Prerequisite",
              "type": "string"
            },
            "dependent": {
              "title": "Dependent",
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/Source"
            }
          },
          "required": [
            "prerequisite",
            "dependent",
            "source"
          ],
          "title": "Edge",
          "type": "object"
        },
        "Source": {
          "additionalProperties": false,
          "properties": {
            "chunkId": {
              "maxLength": 100,
              "minLength": 1,
              "title": "Chunkid",
              "type": "string"
            },
            "quote": {
              "maxLength": 600,
              "minLength": 10,
              "title": "Quote",
              "type": "string"
            }
          },
          "required": [
            "chunkId",
            "quote"
          ],
          "title": "Source",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "concepts": {
          "items": {
            "$ref": "#/$defs/Concept"
          },
          "title": "Concepts",
          "type": "array"
        },
        "prerequisites": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "title": "Prerequisites",
          "type": "array"
        }
      },
      "title": "SectionGraph",
      "type": "object",
      "required": [
        "concepts",
        "prerequisites"
      ]
    }
