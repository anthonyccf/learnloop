# Independent lab database; paths are relative to agent_lab/ (or --workspace).
DATABASE_URL=sqlite:///data/workspace.db
LOCAL_OWNER_ID=agent-lab
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_ENDPOINT=/api/embed
EMBEDDING_DIMENSIONS=1024
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
REQUEST_TIMEOUT_SECONDS=90
WORKER_MAX_ATTEMPTS=3
# API_TOKEN is generated in memory; no server or frontend token is needed.
